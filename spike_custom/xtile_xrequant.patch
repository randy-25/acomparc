+// TILE-ENGINE-MODIFICATION-END
\ No newline at end of file
diff --git a/riscv/processor.cc b/riscv/processor.cc
index 80a47d934249d74d58ec6f46f8151ab369e5a2b1..63cd16c77efeafb369fbcb86a4423ad18ee73a95 100644
--- a/riscv/processor.cc
+++ b/riscv/processor.cc
@@ -103,6 +103,42 @@ void state_t::reset(processor_t* const proc, reg_t max_isa)
   XPR.reset();
   FPR.reset();
 
+  // TILE-ENGINE-MODIFICATION-START
+  // configuration state
+  xtile_cfg = 0;
+  xtile_cfg_valid = false;
+
+  // Input matrix address state.
+  xtile_a_base = 0;
+  xtile_bt_base = 0;
