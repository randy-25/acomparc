+  bool xtile_zp_valid;
+  // TILE-ENGINE-MODIFICATION-END
+
   // control and status registers
   std::unordered_map<reg_t, csr_t_p> csrmap;
   reg_t prv;    // TODO: Can this be an enum instead?
