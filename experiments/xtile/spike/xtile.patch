diff --git a/riscv/insns/xtile_set_zp.h b/riscv/insns/xtile_set_zp.h
new file mode 100644
index 00000000..c36fe953
--- /dev/null
+++ b/riscv/insns/xtile_set_zp.h
@@ -0,0 +1,17 @@
+// TILE-ENGINE-MODIFICATION-START
+
+require_rv64;
+
+// Keep the low 32 bits and interpret them as signed zero points.
+const int32_t a_zp =
+    static_cast<int32_t>(static_cast<uint32_t>(RS1));
+
+const int32_t b_zp =
+    static_cast<int32_t>(static_cast<uint32_t>(RS2));
+
+// Update state after reading both operands.
+STATE.xtile_a_zp = a_zp;
+STATE.xtile_b_zp = b_zp;
+STATE.xtile_zp_valid = true;
+
+// TILE-ENGINE-MODIFICATION-END
\ No newline at end of file
diff --git a/riscv/processor.cc b/riscv/processor.cc
index 80a47d93..7781f666 100644
--- a/riscv/processor.cc
+++ b/riscv/processor.cc
@@ -103,6 +103,26 @@ void state_t::reset(processor_t* const proc, reg_t max_isa)
   XPR.reset();
   FPR.reset();
 
+  // TILE-ENGINE-MODIFICATION-START
+  // configuration state
+  xtile_cfg = 0;
+  xtile_cfg_valid = false;
+
+  // Input matrix address state.
+  xtile_a_base = 0;
+  xtile_bt_base = 0;
+  xtile_ab_valid = false;
+
+  // Output matrix address state.
+  xtile_c_base = 0;
+  xtile_c_valid = false;
+
+  // Zero points require explicit initialization by software.
+  xtile_a_zp = 0;
+  xtile_b_zp = 0;
+  xtile_zp_valid = false;
+  // TILE-ENGINE-MODIFICATION-END
+
   prv = prev_prv = PRV_M;
   v = prev_v = false;
   prv_changed = false;
